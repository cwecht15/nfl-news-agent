# Template for Streamlit Cloud / local secrets.toml.
# Copy to `.streamlit/secrets.toml` for local dev (gitignored), or paste
# the contents into the "Secrets" textarea on Streamlit Community Cloud
# under your app's Settings.
#
# Streamlit reads this file as TOML and exposes values via st.secrets[...].

# --- Required: shared password gate ---
# Anyone visiting the dashboard must enter this password to view it.
# Pick something long and share it only with invited users.
dashboard_password = "REPLACE_WITH_LONG_RANDOM_PASSPHRASE"

# --- Required on Streamlit Cloud for "Save to repo" and the Refresh buttons ---
# A fine-grained personal access token scoped to this repository only.
# Generate at: github.com -> Settings -> Developer settings ->
#   Personal access tokens -> Fine-grained tokens.
#
# Permissions:
#   Contents: Read and write   flags, transaction dismissals, audit dismissals
#                              ("Save ... to repo" buttons; without it those
#                              edits are lost on the next redeploy)
#   Actions:  Read and write   the per-page Refresh buttons, which dispatch
#                              .github/workflows/refresh.yml and then read the
#                              run's status. Contents alone is NOT enough —
#                              dispatching returns 403 "Resource not accessible
#                              by personal access token".
#
# A token that cannot see this repo at all returns 404 rather than 403, so if
# the Refresh button reports "workflow not found", check the token's repository
# scope before checking the workflow file.
#
# GITHUB_PAT = "github_pat_..."

# --- Optional: a second gate on the Refresh buttons ---
# When set, a visitor must enter this once per session before Refresh works.
# Leave it unset (the default) and anyone past dashboard_password can refresh;
# the 180s cooldown and the in-flight gate are what bound the cost.
#
# refresh_password = "..."

# --- Required for the Depth Chart Manager tab ---
# Paste the contents of your Google service-account JSON key file here as
# a TOML table (one key per line). The Depth Chart Manager reads the
# master "2026 Depth Chart" sheet via this account. CI / local runs
# resolve credentials from a file path instead, so this section is only
# needed on Streamlit Cloud.
#
# [gcp_service_account]
# type = "service_account"
# project_id = "fp-data-357113"
# private_key_id = "..."
# private_key = """-----BEGIN PRIVATE KEY-----
# ...multi-line key value...
# -----END PRIVATE KEY-----
# """
# client_email = "fp-data@fp-data-357113.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"
