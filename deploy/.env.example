# Copy to ../.env (project root) and fill in real values.
# Never commit the real .env.

# --- Required ---
OPENAI_API_KEY=sk-replace-me

# --- Google Sheets projection snapshotting ---
# Absolute path to the service-account JSON on this machine.
# If unset, snapshot_projections.py falls back to ./secrets/service_account.json.
GOOGLE_SERVICE_ACCOUNT_KEY=/home/ubuntu/nfl_agent/secrets/service_account.json

# --- Optional: The Athletic scraping ---
# If you exported cookies from your browser, point to the file here.
# Otherwise drop it at ./secrets/athletic_cookies.txt.
# ATHLETIC_COOKIES_PATH=/home/ubuntu/nfl_agent/secrets/athletic_cookies.txt

# --- Optional: Anthropic fallback ---
# ANTHROPIC_API_KEY=sk-ant-replace-me
